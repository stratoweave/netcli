"""Simple router client library for Acton"""

import logging
import net
import pipe
import ssh
import ssh.pipe as sshpipe

import drivers

actor Client(connect_cap: ?net.TCPConnectCap,
             address: str,
             username: str,
             password: ?str = None,
             private_keys: ?list[ssh.PrivateKey] = None,
             on_connect: action(Client, ?Exception) -> None,
             protocol_: str = "ssh",
             port: int = 22,
             device_type: ?str = None,
             skip_host_key_check: bool = False,
             connect_timeout: float = 30.0,
             log_handler: ?logging.Handler = None,
             transport_pipe: ?pipe.Pipe = None):
    """
    Simple router client

    Provides a clean interface for connecting to routers and executing commands.

    Args:
        connect_cap: net.TCPConnectCap for the SSH connection; optional when
                     transport_pipe is supplied
        address: Router IP address or hostname
        username: SSH username
        password: Password for authentication
        private_keys: In-memory private keys for public key authentication
        on_connect: Called with None once the driver is ready for commands,
                    or with the error when connecting fails or the connection
                    is lost later
        protocol_: Connection protocol ("ssh" or "telnet", only ssh supported currently)
        port: Connection port (default: 22 for SSH, 23 for telnet)
        device_type: Device type override (e.g., "juniper_junos", "cisco_iosxr")
        skip_host_key_check: Accept any SSH host key. Otherwise only a host
                             key that is not in known_hosts is accepted, but
                             Client passes no known_hosts yet, so every host
                             key is accepted either way.
        connect_timeout: Seconds from the start until the driver is ready, after
                         which on_connect reports a timeout
        log_handler: Optional logging handler
        transport_pipe: Optional byte-stream pipe for in-process testing
    """

    _log = logging.Logger(log_handler)
    _log.info("Initializing router client", {"address": address, "protocol_": protocol_})

    var _pipe: ?pipe.Pipe = transport_pipe
    var _driver: ?drivers.Driver = None
    # True once on_connect has reported the driver ready
    var _ready_reported = False

    def _initialize_driver(p: pipe.Pipe, detected_type: ?str) -> None:
        # Auto-detect device type if not specified
        selected_type = device_type
        if selected_type is None:
            selected_type = detected_type

        # Create appropriate driver
        if selected_type is not None and selected_type != drivers.DEVICE_TYPE_UNKNOWN:
            _log.info("Using device type", {"device_type": selected_type})
            _driver = drivers.create_driver(selected_type, p, _log)
        else:
            _log.error("Failed to detect device type or unsupported device", {"detected_type": selected_type if selected_type is not None else "None"})
        if _driver is not None:
            _driver.initialize()
        else:
            # Without a driver nothing can use the connection
            disconnect()
            on_connect(self, ValueError("Unsupported device type: " + (selected_type if selected_type is not None else "None")))

    def _on_pipe_event(err: ?Exception, data: ?bytes) -> None:
        if data is not None:
            if _driver is not None:
                _driver.handle_data(data)
                if not _ready_reported and _driver.is_ready():
                    # The driver has run its initialization commands
                    _ready_reported = True
                    on_connect(self, None)
            return

        if err is not None:
            _log.error("Pipe transport error", {"error": err})
            # A pipe error ends the session
            _close(err)
            on_connect(self, err)
            return

        _log.info("Pipe transport connected")
        p = _pipe
        if p is not None:
            _initialize_driver(p, drivers.auto_detect())

    def _on_connect_timeout() -> None:
        # A closed pipe has already been reported
        if not _ready_reported and _pipe is not None:
            _log.error("Timed out waiting for the device", {"connect_timeout": connect_timeout})
            err = OSError("Timed out waiting for the device CLI")
            _close(err)
            on_connect(self, err)

    def _close(error: Exception) -> None:
        # A closed pipe reports nothing more, so fail the pending operations here
        if _driver is not None:
            _driver.handle_disconnect(error)
        if _pipe is not None:
            _pipe.close(None)
        _pipe = None
        _driver = None

    def is_connected() -> bool:
        """Check if client is connected and ready"""
        if _driver is not None:
            return _driver.is_ready()
        return False

    def cmd(cb: action(err: ?Exception, response: ?str) -> None, command: str) -> None:
        """
        Run a command on device and return the result via callback

        Args:
            cb: Callback function receiving (error, response)
            command: Command to execute
        """
        if _driver is not None and is_connected():
            _driver.execute_command(cb, command)
        else:
            cb(Exception("Not connected or driver not initialized"), None)

    def configure_and_commit(on_success: action(response: str) -> None,
                            on_error: action(err: Exception, response: str) -> None,
                            config: list[str],
                            skip_pre_config: bool = False) -> None:
        """
        Apply configuration and commit atomically

        This is the primary method for making configuration changes. The configuration
        is applied and immediately committed as a single atomic operation. If commit fails,
        the configuration is automatically rolled back by the driver.

        Args:
            on_success: Callback for successful commit (receives response text)
            on_error: Callback for any failure (receives error and response text)
            config: List of configuration commands
            skip_pre_config: Skip pre-configuration steps (e.g., archive checkpoint).
                           WARNING: This disables automatic rollback on failure!
        """
        if _driver is not None and is_connected():
            def _on_complete(err: ?Exception, session_log: str) -> None:
                if err is not None:
                    on_error(err, session_log)
                else:
                    on_success(session_log)

            _driver.configure_and_commit(_on_complete, config, skip_pre_config)
        else:
            on_error(Exception("Not connected or driver not initialized"), "")


    def rollback_commits(cb: action(err: ?Exception, session_log: str) -> None, commits_back: int) -> None:
        """
        Rollback previously committed configuration changes

        Args:
            cb: Callback function receiving error (if any)
            commits_back: Number of commits to rollback (must be >= 1)
        """
        if _driver is not None and is_connected():
            _driver.rollback_configuration(cb, commits_back)
        else:
            cb(Exception("Not connected or driver not initialized"), "")


    def disconnect() -> None:
        """Disconnect from the device"""
        _close(Exception("Client disconnected"))

    def get_device_info() -> ?dict[str, str]:
        """Get device information"""
        if _driver is not None:
            return _driver.get_device_info()
        else:
            return None

    # Validate protocol
    if transport_pipe is None and protocol_ != "ssh":
        _log.error("Unsupported protocol", {"protocol_": protocol_})
        # For now, only SSH is supported
        raise ValueError("Unsupported protocol: " + protocol_)

    # Adjust port if default
    actual_port = port
    if port == 22 and protocol_ == "ssh":
        actual_port = 22
    elif port == 23 and protocol_ == "telnet":
        actual_port = 23

    # Initialize connection
    if transport_pipe is None:
        cap = connect_cap
        if cap is not None:
            _log.debug("Starting SSH connection", {"address": address, "port": actual_port})
            # The device CLI needs an interactive shell with a PTY
            _pipe = sshpipe.SshPipe(
                cap,
                address=address,
                port=actual_port,
                username=username,
                password=password,
                private_keys=private_keys,
                shell=True,
                host_key_check=sshpipe.HOST_KEY_CHECK_NONE if skip_host_key_check else sshpipe.HOST_KEY_CHECK_ACCEPT_NEW,
                connect_timeout=connect_timeout,
                log_handler=log_handler
            )
        else:
            on_connect(self, ValueError("TCP connect capability is required for SSH transport"))
    if _pipe is not None:
        _pipe.read_cb(_on_pipe_event)
        # The timeout counts from here, not from the baseline of the message that created the client
        after now connect_timeout: _on_connect_timeout()
